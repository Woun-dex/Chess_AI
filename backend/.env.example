# Chess AI Tutor Environment Configuration
APP_NAME="Chess AI Tutor API"
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Relational Persistence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chess_ai

# Cache & Distributed Task Broker
REDIS_URL=redis://localhost:6379/0

# Stockfish Engine Configuration
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEFAULT_DEPTH=18
STOCKFISH_ANALYSIS_THREADS=2
STOCKFISH_MAX_CONCURRENT_ENGINES=4

# Pedagogical LLM Coach Configuration
LLM_PROVIDER=ollama
LLM_API_KEY=""
LLM_MODEL_NAME=gemma2:9b
LLM_BASE_URL=http://localhost:11434

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
